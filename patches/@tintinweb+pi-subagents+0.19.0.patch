+/**
+ * result-history.ts — Read a subagent's FINAL result back out of the session's
+ * own persisted entries, for the case where the live record is already gone.
+ *
+ * `AgentManager.cleanup()` evicts finished records ten minutes after they
+ * settle, and that eviction is what bounds memory — so it is deliberate, and
+ * must not be traded away for reachability. The same extension already writes
+ * every terminal record into the session as `subagents:record`, so the result
+ * outlives the record it came from; this module is the reader for it.
+ *
+ * Two rules carry the weight here:
+ *
+ * - The newest match wins, and an unusable newest match ends the search.
+ *   `subagents:result-state` marks a run that has started but not settled, so
+ *   a stale earlier answer sitting behind it belongs to a PREVIOUS run and
+ *   must not be served as this one's. Same for a damaged snapshot: falling
+ *   back to an older success would answer a question it cannot answer.
+ * - Only the fields that reach the caller are validated. The snapshot's other
+ *   fields (timestamps, usage, ids) are informational, and a shape change in
+ *   one of them is not a reason to discard a result that is otherwise intact.
+ *
+ * Deliberately narrow: exact `agent_id` only. Handles and output-file paths
+ * are not part of this contract.
+ */
+const TERMINAL = new Set(["completed", "steered", "stopped", "aborted", "error"]);
+const SNAPSHOT_TYPES = ["subagents:record", "subagents:result-state"];
+
+function object(value) {
+    return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+/**
+ * Find the terminal snapshot for `id` in `entries` (session order).
+ * Returns undefined when the newest match is a start barrier, a non-terminal
+ * status, or malformed.
+ */
+export function findHistoricalResult(entries, id) {
+    for (let i = entries.length - 1; i >= 0; i--) {
+        const entry = entries[i];
+        if (!object(entry) ||
+            entry.type !== "custom" ||
+            !SNAPSHOT_TYPES.includes(entry.customType) ||
+            !object(entry.data) ||
+            entry.data.id !== id)
+            continue;
+        const data = entry.data;
+        // Start barrier, or an older/unknown host's non-terminal record: the
+        // newest thing we know about this agent is "not settled yet".
+        if (entry.customType === "subagents:result-state" || !TERMINAL.has(data.status))
+            return;
+        if (data.result !== undefined && typeof data.result !== "string")
+            return;
+        if (data.error !== undefined && typeof data.error !== "string")
+            return;
+        return { id, status: data.status, result: data.result, error: data.error };
+    }
+}
+
+/**
+ * Render a historical result. Every non-clean status is stated in words, so a
+ * partial output can't be mistaken for a completed answer, and the source line
+ * tells the caller why `verbose` cannot return a conversation.
+ */
+export function formatHistoricalResult(record, verbose = false) {
+    const notes = {
+        stopped: "STOPPED BY THE USER; task unfinished; output is partial",
+        aborted: "Aborted at the turn limit; output may be incomplete",
+        steered: "Wrapped up at the turn limit; output may be partial",
+        error: "Failed; any saved output is partial",
+    };
+    let text = `Agent ID: ${record.id}\nStatus: ${record.status}\n` +
+        "Source: persisted result from the current parent session\n";
+    if (notes[record.status])
+        text += `${notes[record.status]}\n`;
+    if (record.status === "error")
+        text += `Error: ${record.error ?? "unknown"}\n`;
+    text += `\n${record.result?.trim() || "No final output was saved."}`;
+    if (verbose)
+        text += "\n\nFull conversation is unavailable in this historical snapshot.";
+    return text;
+}
