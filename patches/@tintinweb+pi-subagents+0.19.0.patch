+/**
+ * Type surface for result-history.js (the implementation is plain JS in this
+ * package's dist; this declaration is what the TS side sees).
+ */
+export type HistoricalResultStatus =
+    | "completed"
+    | "steered"
+    | "stopped"
+    | "aborted"
+    | "error";
+
+export interface HistoricalResult {
+    id: string;
+    status: HistoricalResultStatus;
+    /** The run's final assistant text, when it was saved. */
+    result?: string;
+    /** Failure text for `status: "error"`. */
+    error?: string;
+}
+
+export declare function findHistoricalResult(
+    entries: readonly unknown[],
+    id: string,
+): HistoricalResult | undefined;
+
+export declare function formatHistoricalResult(
+    record: HistoricalResult,
+    verbose?: boolean,
+): string;
